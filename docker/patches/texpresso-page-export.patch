+/*
+ * This is intentionally separate from txp_renderer_render: it reuses the
+ * engine's current page display-list, but writes a browser-native PNG rather
+ * than uploading pixels to SDL.  It is a tiny experimental editor-protocol
+ * extension for Typr's local render POC, not a stable upstream protocol.
+ */
+static void export_page_png(struct persistent_state *ps, ui_state *ui,
+                            int page, int dpi, int tint,
+                            int foreground, int background)
+{
+  if (page < 0 || page >= send(page_count, ui->eng))
+  {
+    editor_page_error(page, "page is not available in the current document state");
+    return;
+  }
+  if (dpi < 36 || dpi > 300)
+  {
+    editor_page_error(page, "dpi must be between 36 and 300");
+    return;
+  }
+
+  fz_display_list *dl = NULL;
+  fz_pixmap *pixmap = NULL;
+  fz_device *device = NULL;
+  fz_buffer *png = NULL;
+  fz_output *output = NULL;
+  fz_var(dl);
+  fz_var(pixmap);
+  fz_var(device);
+  fz_var(png);
+  fz_var(output);
+
+  fz_try(ps->ctx)
+  {
+    dl = send(render_page, ui->eng, ps->ctx, page);
+    fz_rect bounds = fz_bound_display_list(ps->ctx, dl);
+    fz_matrix ctm = fz_scale((float)dpi / 72.0f, (float)dpi / 72.0f);
+    fz_irect bbox = fz_round_rect(fz_transform_rect(bounds, ctm));
+    pixmap = fz_new_pixmap_with_bbox(ps->ctx, fz_device_rgb(ps->ctx), bbox, NULL, 0);
+    fz_clear_pixmap_with_value(ps->ctx, pixmap, 255);
+    device = fz_new_draw_device(ps->ctx, ctm, pixmap);
+    fz_run_display_list(ps->ctx, dl, device, fz_identity, bounds, NULL);
+    fz_close_device(ps->ctx, device);
+    fz_drop_device(ps->ctx, device);
+    device = NULL;
+    if (tint)
+      fz_tint_pixmap(ps->ctx, pixmap, foreground, background);
+
+    png = fz_new_buffer(ps->ctx, 0);
+    output = fz_new_output_with_buffer(ps->ctx, png);
+    fz_write_pixmap_as_png(ps->ctx, output, pixmap);
+    fz_close_output(ps->ctx, output);
+    fz_drop_output(ps->ctx, output);
+    output = NULL;
+
+    unsigned char *data;
+    size_t len = fz_buffer_storage(ps->ctx, png, &data);
+    editor_page_image(page, fz_pixmap_width(ps->ctx, pixmap),
+                      fz_pixmap_height(ps->ctx, pixmap), data, (int)len);
+  }
+  fz_always(ps->ctx)
+  {
+    if (output) fz_drop_output(ps->ctx, output);
+    if (device) fz_drop_device(ps->ctx, device);
+    if (png) fz_drop_buffer(ps->ctx, png);
+    if (pixmap) fz_drop_pixmap(ps->ctx, pixmap);
+    if (dl) fz_drop_display_list(ps->ctx, dl);
+  }
+  fz_catch(ps->ctx)
+  {
+    editor_page_error(page, fz_caught_message(ps->ctx));
+  }
+}
+
+static void request_page_export(struct persistent_state *ps, ui_state *ui,
+                                int page, int dpi, int tint,
+                                int foreground, int background)
+{
+  if (page < 0 || dpi < 36 || dpi > 300)
+  {
+    editor_page_error(page, "page or dpi is outside the supported export range");
+    return;
+  }
+  if (page < send(page_count, ui->eng))
+  {
+    export_page_png(ps, ui, page, dpi, tint, foreground, background);
+    return;
+  }
+  /* TeXpresso incrementally discovers pages only as the viewer reaches them. */
+  ui->page = page;
+  ui->pending_render_page = page;
+  ui->pending_render_dpi = dpi;
+  ui->pending_render_tint = tint;
+  ui->pending_render_foreground = foreground;
+  ui->pending_render_background = background;
+  schedule_event(RELOAD_EVENT);
+}
 
