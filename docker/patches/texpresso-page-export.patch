+static void output_base64(FILE *f, const unsigned char *data, int len)
+{
+  static const char table[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  for (int i = 0; i < len; i += 3)
+  {
+    int remain = len - i;
+    unsigned value = (unsigned)data[i] << 16;
+    if (remain > 1) value |= (unsigned)data[i + 1] << 8;
+    if (remain > 2) value |= data[i + 2];
+    putc_unlocked(table[(value >> 18) & 63], f);
+    putc_unlocked(table[(value >> 12) & 63], f);
+    putc_unlocked(remain > 1 ? table[(value >> 6) & 63] : '=', f);
+    putc_unlocked(remain > 2 ? table[value & 63] : '=', f);
+  }
+}
+
+void editor_page_image(int page, int width, int height,
+                       const unsigned char *data, int len)
+{
+  switch (protocol)
+  {
+    case EDITOR_SEXP:
+      fprintf(stdout, "(page-image %d %d %d \"image/png\" \"", page, width, height);
+      break;
+    case EDITOR_JSON:
+      fprintf(stdout, "[\"page-image\", %d, %d, %d, \"image/png\", \"", page, width, height);
+      break;
+  }
+  output_base64(stdout, data, len);
+  fprintf(stdout, protocol == EDITOR_SEXP ? "\")\n" : "\"]\n");
+  fflush(stdout);
+}
+
+void editor_page_count(int count)
+{
+  switch (protocol)
+  {
+    case EDITOR_SEXP: fprintf(stdout, "(page-count %d)\n", count); break;
+    case EDITOR_JSON: fprintf(stdout, "[\"page-count\", %d]\n", count); break;
+  }
+  fflush(stdout);
+}
+
+void editor_page_error(int page, const char *message)
+{
+  switch (protocol)
+  {
+    case EDITOR_SEXP: fprintf(stdout, "(page-image-error %d \"", page); break;
+    case EDITOR_JSON: fprintf(stdout, "[\"page-image-error\", %d, \"", page); break;
+  }
+  output_data_string(stdout, message, strlen(message));
+  fprintf(stdout, protocol == EDITOR_SEXP ? "\")\n" : "\"]\n");
+  fflush(stdout);
+}
